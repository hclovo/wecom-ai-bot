# ===== 企业微信 / 微信客服 =====
# 管理后台「我的企业 → 企业信息」里的企业 ID
WECOM_CORP_ID=wwxxxxxxxxxxxxxxxxxx
# 「应用管理 → 微信客服 → API」里的 Secret
WECOM_KF_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 回调配置里你自己填的 Token 和 EncodingAESKey（43 位字符）
WECOM_TOKEN=yourCallbackToken
WECOM_ENCODING_AES_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 解密校验用的 receiveId，默认等于 CorpID，一般不用填
# WECOM_RECEIVE_ID=
# 只处理指定客服账号（wk 开头），留空则处理所有客服账号
# WECOM_OPEN_KFID=

# ===== 模型调用方式 =====
# api 使用下面的接口配置；cursor 使用 Cursor 账号登录，启动时显示登录链接
LLM_PROVIDER=api
# CURSOR_MODEL=auto
# CURSOR_AGENT_BIN=cursor-agent
# CURSOR_TIMEOUT_MS=120000
# CURSOR_STATE_DIR=./.cursor-agent-state

# ===== API 模式（cursor 模式不要求填写以下三项）=====
# 统一填到版本号一层；chat/completions、files、responses 三个端点基于它拼接
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=your-ark-api-key
# 文本对话与 PDF 理解用的接入点 ID（ep-xxxx）或模型名
LLM_MODEL=ep-2024xxxxxxxxxxxxxxxx
# 看图模型（需支持视觉输入），不填则复用 LLM_MODEL
# LLM_VISION_MODEL=ep-2024xxxxxxxxxxxxxxxx

# ===== 可选 =====
# LLM_SYSTEM_PROMPT=你是一位用户的好朋友，通过微信聊天……
# MAX_HISTORY_TURNS=12
# 接收图片/文件的大小上限（MB）
# FILE_MAX_MB=20
# PORT=8788
# WECOM_API_BASE=https://qyapi.weixin.qq.com

# ===== 持久化与资源限制 =====
# 必填：直接连接你已有的 PostgreSQL；密码中的特殊字符需 URL 编码
DATABASE_URL=postgresql://wecom_bot:replace-password@your-postgres-host:5432/wecom_bot
# 本程序拥有的 schema，启动时自动创建表（首次需要 CREATE 权限）
# DATABASE_SCHEMA=wecom_bot
# 连接池至少 2 个连接，其中 1 个用于持有单实例锁
# DATABASE_POOL_SIZE=10
# 数据库连接/语句超时（毫秒），范围 100–30000
# DATABASE_TIMEOUT_MS=2000
# 每个账号/好友组合每日最多请求数（UTC 零点刷新；指令不计数）
# DAILY_REQUEST_LIMIT=100
# 不同好友最大并发任务，同一好友仍按顺序
# MAX_CONCURRENT_JOBS=2
# 等待处理与等待发送的总消息数上限，满时暂停同步，不推进游标
# MAX_QUEUE_SIZE=1000
# 上游请求超时和 PDF 上传/处理/问答总超时（毫秒）
# UPSTREAM_TIMEOUT_MS=30000
# FILE_TASK_TIMEOUT_MS=90000
# 已知客服账号定期补拉间隔，不要低于官方频率限制
# SYNC_POLL_MS=60000
# RETRY_BASE_MS=1000
# MAX_SEND_ATTEMPTS=5
# 会话及完成/失败消息的保留天数
# RETENTION_DAYS=30
# 媒体接口兼容性配置，待目标账号真实验收
# WECOM_MEDIA_PATH=/cgi-bin/media/get

# ===== SVG 绘图（普通文本模型生成 SVG，再本地渲染成图片）=====
# 默认复用 LLM_MODEL、LLM_BASE_URL、LLM_API_KEY，不需要独立图片生成接口
# 可指定同一文本接口下更擅长生成 SVG 的模型
# SVG_MODEL=
# SVG_TIMEOUT_MS=120000
# 微信发送遇到 95018 时，是否尝试将未处理(state=0)转为智能助手接待
# 默认关闭；即使打开也不转换排队/人工接待/已结束会话，权限需真机验证
# WECOM_AUTO_TAKEOVER=false
