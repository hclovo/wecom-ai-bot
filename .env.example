# ===== 企业微信 / 微信客服 =====
# 管理后台「我的企业 → 企业信息」里的企业 ID
WECOM_CORP_ID=wwxxxxxxxxxxxxxxxxxx
# 「应用管理 → 微信客服 → API」里的 Secret
WECOM_KF_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 回调配置里你自己填的 Token 和 EncodingAESKey（43 位字符）
WECOM_TOKEN=yourCallbackToken
WECOM_ENCODING_AES_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 解密校验用的 receiveId，默认等于 CorpID，一般不用填
# WECOM_RECEIVE_ID=
# 只处理指定客服账号（wk 开头），留空则处理所有客服账号
# WECOM_OPEN_KFID=

# ===== 大模型（火山方舟 OpenAI 兼容接口）=====
# 统一填到版本号一层；chat/completions、files、responses 三个端点基于它拼接
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=your-ark-api-key
# 文本对话与文档理解用的接入点 ID（ep-xxxx）或模型名
LLM_MODEL=ep-2024xxxxxxxxxxxxxxxx
# 看图模型（需支持视觉输入），不填则复用 LLM_MODEL
# LLM_VISION_MODEL=ep-2024xxxxxxxxxxxxxxxx

# ===== 可选 =====
# LLM_SYSTEM_PROMPT=你是一位用户的好朋友，通过微信聊天……
# MAX_HISTORY_TURNS=12
# 接收图片/文件的大小上限（MB）
# FILE_MAX_MB=20
# PORT=8788
# WECOM_API_BASE=https://qyapi.weixin.qq.com
